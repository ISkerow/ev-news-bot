BOT_TOKEN=your_bot_token_here
CHANNEL_ID=-100your_channel_id
ADMIN_ID=your_admin_id
MANAGER_URL=https://t.me/your_manager_username
# DB_PATH=/data/news_production.db  # optional: custom database location (e.g. a mounted volume)
# QUIET_HOURS=23-7                  # optional: no posts during these hours (in TIMEZONE local time)
# TIMEZONE=Asia/Almaty              # IANA timezone for quiet hours, default UTC
# GEMINI_API_KEY=your_key_here      # optional: AI rewrite of posts (aistudio.google.com); unset = plain translation
# GEMINI_MODEL=gemini-3.8-flash     # optional: Gemini model for the rewrite
# MAX_POSTS_PER_DAY=6               # optional: daily post cap (per TIMEZONE day); unset = unlimited
# MAX_NEWS_AGE_HOURS=24             # optional: never publish articles older than this (default 24, 0 = off)
# QUEUE_GRACE_HOURS=12              # optional: extra hours granted to items already queued (default 12)
# SIMILARITY_CANDIDATE=0.3          # optional: title similarity that sends a pair to the AI check (default 0.3)
# SIMILARITY_THRESHOLD=0.7          # optional: lexical duplicate threshold used when AI is unavailable (default 0.7)
# WHATSAPP_PHONE=77011234567        # dealership WhatsApp number, digits only; empty = no WhatsApp button
# BUTTON_TEXT=🚗 Подобрать электромобиль
# WHATSAPP_MESSAGE=Здравствуйте! Увидел новость: «{title}». Хочу узнать подробнее.
# CTA_TEXT=Интересуют электромобили? Напишите нам — подберём модель под ваш бюджет.
# TELEGRAM_USERNAME=ev_almaty_manager   # Telegram nick for the second button, without @; empty = WhatsApp only
# TELEGRAM_BUTTON_TEXT=✈️ Написать в Telegram
# PRICE_NOTE=ℹ️ Цена указана для рынка Китая.   # appended when a post mentions a price in yuan or dollars
